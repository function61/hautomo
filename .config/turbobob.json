{
	"for_description_of_this_file_see": "https://github.com/function61/turbobob",
	"version_major": 1,
	"project_name": "hautomo",
	"project_emoji_icon": "🤖",
	"builders": [
		{
			"name": "default",
			"uses": "docker://fn61/buildkit-golang:20250109_1140_037f68db",
			"mount_destination": "/workspace",
			"workdir": "/workspace",
			"commands": {
				"build": ["build-go-project.sh", "--directory=cmd/hautomo/", "--binary-basename=hautomo"],
				"dev": ["bash"]
			}
		},
		{
			"name": "publisher",
			"uses": "docker://fn61/buildkit-publisher:20190206_1058_d35b3939",
			"mount_destination": "/workspace",
			"commands": {
				"publish": ["publish.sh", "rel/*"]
			},
			"env": {
				"BINTRAY_PROJECT": "function61/dl/hautomo"
			},
			"pass_envs": ["BINTRAY_CREDS"]
		}
	],
	"os_arches": {
		"linux-amd64": true,
		"linux-arm": true
	}
}
